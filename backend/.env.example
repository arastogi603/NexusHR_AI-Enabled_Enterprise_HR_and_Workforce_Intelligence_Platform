# ==============================================================================
# NexusHR Backend Environment Configuration
# ==============================================================================

# Server Port (Render/Railway sets PORT automatically)
PORT=8080

# Database Configuration (PostgreSQL / Neon / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/nexushr
SPRING_DATASOURCE_USERNAME=nexushr
SPRING_DATASOURCE_PASSWORD=secretpassword

# Redis Cache & Session Configuration (Local or Upstash)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# JWT Authentication Secret (HS256 min 256 bits)
JWT_SECRET=9a4f2c8d3b7a1e6f45c8a0b3f267d8b1d4e6f3c8a9d2b5f8e3a9c8b5f6v8a3d9
JWT_EXPIRATION=86400000

# Mailtrap / SendGrid SMTP Credentials
SPRING_MAIL_HOST=smtp.mailtrap.io
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=dummy_user
SPRING_MAIL_PASSWORD=dummy_password

# Spring AI (Optional for AI attrition insights & chat)
OPENAI_API_KEY=dummy_key_for_build
OPENAI_MODEL=gpt-4o
