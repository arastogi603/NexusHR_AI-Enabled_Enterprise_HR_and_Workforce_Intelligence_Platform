# ==============================================================================
# NexusHR Backend Environment Configuration
# ==============================================================================

# Server Port (Render sets PORT automatically, e.g. 10000 or 8080)
PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database (Aiven / Neon / Local)
# For Aiven: copy Service URI (e.g. postgres://avnadmin:pass@pg-xxx.aivencloud.com:12345/defaultdb?sslmode=require)
# and convert to JDBC format:
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://pg-xxx.aivencloud.com:12345/defaultdb?sslmode=require
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_aiven_password

# ------------------------------------------------------------------------------
# Redis Cache & Session Configuration (Render Redis / Upstash / Local)
# Option A: Full Render Internal/External Redis URI
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_URL=redis://red-xxxxxxxxxxxx:6379

# Option B: Separate host, port, and password
SPRING_DATA_REDIS_HOST=red-xxxxxxxxxxxx
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Security & JWT Token Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=9a4f2c8d3b7a1e6f45c8a0b3f267d8b1d4e6f3c8a9d2b5f8e3a9c8b5f6v8a3d9
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# Mailtrap / SendGrid SMTP Credentials (Optional for local test)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.mailtrap.io
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=dummy_user
SPRING_MAIL_PASSWORD=dummy_password

# ------------------------------------------------------------------------------
# Spring AI Configuration (Optional: fallback to deterministic rule engine if blank)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=dummy_key_for_build
OPENAI_MODEL=gpt-4o
