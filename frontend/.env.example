# ==============================================================================
# NexusHR Frontend Environment Configuration
# ==============================================================================

# Backend API Gateway URL for server-side proxying/rewrites in Next.js
# In local development: http://localhost:8080
# In Docker compose: http://backend:8080
# In Cloud deployment (e.g., Render/Railway): https://nexushr-api.onrender.com
API_GATEWAY_URL=http://localhost:8080

# Client-side API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Real-Time WebSocket Endpoint (STOMP over SockJS / Native WS)
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
